# Copy to .env when running the configurable local gateways.
# Never commit real tokens or API keys.
# Task 2 development only. Generate a unique value of at least 32 characters.
TASK2_JWT_SECRET=replace-with-a-random-development-key-at-least-32-characters
TASK2_DOWNSTREAM_URL=http://127.0.0.1:9001/mcp
TASK2_DOWNSTREAM_TIMEOUT_SECONDS=2.0
TASK3_PROVIDER_URL=http://127.0.0.1:9011/v1/provider/stream
TASK3_CONNECT_TIMEOUT_SECONDS=2.0
TASK3_READ_TIMEOUT_SECONDS=10.0
TASK3_MAX_CANDIDATE_CHARS=320
TASK3_MAX_SSE_EVENT_CHARS=65536
TASK4_RATE_LIMIT_DB_PATH=./var/rate_limits.sqlite3
TASK4_TENANT_KEYS_JSON={"tenant-a":"replace-with-local-development-key"}
TASK4_TENANT_HASH_SECRET=replace-with-random-value-at-least-32-characters
TASK4_PRIMARY_URL=http://127.0.0.1:9021/v1/primary/completions
TASK4_SECONDARY_URL=http://127.0.0.1:9021/v1/secondary/completions
TASK4_PRIMARY_TIMEOUT_SECONDS=3.0
TASK4_PROVIDER_TIMEOUT_SECONDS=10.0
TASK4_TOKEN_LIMIT=50000
TASK4_WINDOW_SECONDS=60
TASK4_SQLITE_BUSY_TIMEOUT_MS=5000
